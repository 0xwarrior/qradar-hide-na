{
  "manifest_version": 3,
  "name": "QRadar Declutter",
  "version": "1.2.1",
  "description": "Declutters IBM QRadar: hides N/A event rows, plus the Magnitude column and infographics on the Offenses tab. Toggle each on or off.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "QRadar Declutter"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-na-rows": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Toggle hiding of N/A event rows"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
